{
  "name": "@ayco/astro-sw",
  "author": "Ayo Ayco",
  "license": "MIT",
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayo-run/astro-sw.git"
  },
  "description": "Use your own authored service worker with Astro",
  "exports": {
    ".": {
      "types": "./dist/astro-sw.d.ts",
      "default": "./dist/astro-sw.js"
    },
    "./globals": {
      "types": "./dist/eslint/globals.d.ts",
      "default": "./dist/eslint/globals.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "main": "./dist/astro-sw.js",
  "types": "./dist/astro-sw.d.ts",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsup src/astro-sw.ts src/eslint/globals.ts --format esm --dts --clean",
    "prepack": "echo 'PREPACK...' && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier . --write",
    "lint": "eslint . --config eslint.config.mjs --cache",
    "lint:fix": "eslint . --config eslint.config.mjs --fix",
    "check": "npm run format && npm run lint",
    "prepare": "husky && npm run build",
    "bump": "npm run release:check && bumpp",
    "release": "node ./scripts/release.js",
    "release:check": "npm run build && npm run lint && npm run test && npm run build:demo && pnpm -F demo-static build",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "build:demo": "npm run build && pnpm -F demo build",
    "demo": "npm run build && pnpm -F demo build:preview",
    "dev": "npm run demo",
    "demo:static": "npm run build && pnpm -F demo-static build:preview",
    "dev:static": "npm run demo:static"
  },
  "keywords": [
    "withastro",
    "perf"
  ],
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "astro": "^6 || ^7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "astro-eslint-parser": "^1.4.0",
    "bumpp": "^12.2.1",
    "changelogithub": "15.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.2",
      "tar": "^7.5.21"
    }
  }
}
